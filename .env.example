# Local defaults are explicit in compose.yaml. No credentials required.
# Configure providers through the app; never commit secrets or cookies.

# Optional provider-issued API client key for PrivadoVPN credential login.
# Leave blank when uploading a WireGuard profile instead.
REELDOCK_PRIVADO_API_KEY=

# Absolute installation root used by the portable Compose templates.
REELDOCK_INSTALL_DIR=/DATA/AppData/reeldock-v13
